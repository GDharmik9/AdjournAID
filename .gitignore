# ==============================================================================
# AdjournAID Master .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
.env
.env*
.env *
!.env.example
*.pem
*.key
*.cert
*.crt
*service-account*.json
*credentials*.json

# ------------------------------------------------------------------------------
# 2. Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.cache
.pytest_cache/
.coverage
.coverage.*
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Type Checking & Linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend (Vite, React, Tailwind)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Production Build Outputs
frontend/dist/
frontend/dist-ssr/
frontend/build/
*.local

# Editor & Linter caches
.eslintcache
.stylelintcache
.vite/

# ------------------------------------------------------------------------------
# 4. Zero-Data-Retention (ZDR) & Ephemeral Storage
# ------------------------------------------------------------------------------
backend/ephemeral_sessions/
ephemeral_sessions/
*.faiss
*.index

# Logs & Diagnostics
*.log
logs/
*.out

# ------------------------------------------------------------------------------
# 5. OS & Editor Specific Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / PyCharm / WebStorm
.idea/
*.iws
*.iml
*.ipr
out/

# Temporary / Swap Files
*.swp
*.swo
*~
*.bak
*.tmp
*.temp
