# ==============================================================================
# AdjournAID Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Active Inference Provider
# ------------------------------------------------------------------------------
# Choose one of: "vertex_ai", "gemini", "local_saul_lm", "fallback"
LLM_PROVIDER=vertex_ai

# ------------------------------------------------------------------------------
# 2. Google Cloud Vertex AI Configuration (Recommended for GCP / Hackathons)
# ------------------------------------------------------------------------------
# Your Google Cloud Project ID with the Vertex AI API enabled (aiplatform.googleapis.com)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Vertex AI Region (e.g. us-central1, us-east4, etc.)
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini model identifier on Vertex AI
GEMINI_MODEL=gemini-2.0-flash

# Optional: Explicit service account key file path.
# If omitted, the Google GenAI SDK will automatically use Application Default Credentials (ADC)
# obtained via: gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# ------------------------------------------------------------------------------
# 3. Alternative: Gemini API Key (Direct Google AI Studio)
# ------------------------------------------------------------------------------
# If you prefer using an API key directly rather than Vertex AI ADC:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ------------------------------------------------------------------------------
# 4. Local Air-Gapped SaulLM-7B / vLLM (Concept A: Zero Data Retention)
# ------------------------------------------------------------------------------
# SAULLM_API_URL=http://localhost:8000/v1
# SAULLM_MODEL_NAME=Equall/Saul-7B-Instruct-v1
# OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Server & Pipeline Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=False
